# Existing host defaults: omit DB_BACKEND to use DATABASE_URL, otherwise SQLite.
# DB_BACKEND=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_BACKEND=sqlite
# SQLITE_PATH=/private/path/listings.db

# Cloud HTTPS database (server-side settings only).
DB_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# In cloud, supply this as a network secret scoped to YOUR_PROJECT.supabase.co.
SUPABASE_SECRET_KEY=

# Existing host default: smtp-imap with GMAIL_USER and GMAIL_APP_PASSWORD.
# MAIL_BACKEND=smtp-imap
# GMAIL_APP_PASSWORD=

MAIL_BACKEND=gmail-api
GMAIL_USER=your-mailbox@gmail.com
GMAIL_CLIENT_ID=your-desktop-client.apps.googleusercontent.com
# Scope both secrets below to oauth2.googleapis.com in cloud.
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Local alternative: private JSON written by npm run gmail:authorize.
# GMAIL_CREDENTIALS_FILE=/private/path/gmail-credentials.json

# Use the environment-provided proxy and trust roots; set before starting Node.
# HTTPS_PROXY=http://proxy-host:port
# HTTP_PROXY=http://proxy-host:port
# NO_PROXY=localhost,127.0.0.1
# NODE_EXTRA_CA_CERTS=/path/to/environment-ca.pem
# SSL_CERT_FILE=/path/to/environment-ca.pem

# Existing optional workflows need their own configuration.
# GEMINI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
DAEMON_MODE=false

# Optional Google commute button. Server-side only; never use a VITE_ variable.
# Enable Routes API + billing, restrict this key to Routes API and server egress IPs.
# Cloud network secret allowed destination: routes.googleapis.com
# GOOGLE_MAPS_API_KEY=
# After correcting an API/billing/key restriction error with the same key, change
# this revision and restart the API to clear its persistent configuration block.
# GOOGLE_MAPS_CONFIG_VERSION=1
